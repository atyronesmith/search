{
  "name": "file-search-frontend",
  "version": "1.0.0",
  "description": "File Search System Frontend - Electron + React",
  "main": "public/electron.js",
  "private": true,
  "homepage": "./",
  "dependencies": {
    "axios": "^1.15.0",
    "classnames": "^2.3.2",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^8.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^2.0.0",
    "vite": "^7.1.0",
    "wait-on": "^7.0.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "build-electron": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --publish=never",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.filesearch.app",
    "productName": "File Search System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "public/electron.js",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
