{
  "name": "file-search-frontend",
  "version": "1.0.0",
  "description": "Electron + React frontend for file search system",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "electron": "electron .",
    "electron-dev": "ELECTRON_IS_DEV=1 electron .",
    "pack": "electron-builder",
    "prepack": "npm run build",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron-dev\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.14",
    "@mui/material": "^5.15.14",
    "@mui/x-data-grid": "^7.0.0",
    "@mui/x-date-pickers": "^6.20.2",
    "axios": "^1.15.0",
    "chart.js": "^4.4.2",
    "date-fns": "^2.30.0",
    "highlight.js": "^11.9.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.14.0",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "^2.12.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.23",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^8.2.2",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.6.0",
    "vite": "^7.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "extends": null,
    "appId": "com.filesearch.app",
    "productName": "File Search",
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
